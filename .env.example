# ---- LLM ----
# Proveedor del modelo. Local: groq (gratis). Producción (DigitalOcean): openai.
LLM_PROVIDER=groq
# Modelo a usar. Para groq: llama-3.3-70b-versatile | llama-3.1-8b-instant
# Para openai: gpt-4o-mini | gpt-4o
LLM_MODEL=llama-3.3-70b-versatile

# API keys (solo se necesita la del proveedor activo)
GROQ_API_KEY=tu_groq_api_key_aqui
OPENAI_API_KEY=

# ---- Búsqueda web ----
# Tavily: tier gratis ~1000 créditos/mes, sin tarjeta. https://app.tavily.com
TAVILY_API_KEY=tu_tavily_api_key_aqui

# ---- Geocoding (OpenStreetMap / Nominatim) ----
# La política de uso exige un User-Agent identificable (app + contacto).
NOMINATIM_USER_AGENT=inmobiliaria-poc/0.1 (contacto@ejemplo.cl)

# ---- Parámetros opcionales ----
# Radio de búsqueda de POIs en metros
POI_RADIUS_M=1000
# Activar/desactivar el componente de delincuencia (true/false)
ENABLE_CRIME=true
