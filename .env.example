# ---- LLM ----
# Proveedor del modelo. Local: groq (gratis). Producción (DigitalOcean): openai.
LLM_PROVIDER=groq
# Modelo a usar. Para groq: llama-3.3-70b-versatile | llama-3.1-8b-instant
# Para openai: gpt-4o-mini | gpt-4o
LLM_MODEL=llama-3.3-70b-versatile

# API keys (solo se necesita la del proveedor activo)
GROQ_API_KEY=tu_groq_api_key_aqui
OPENAI_API_KEY=

# ---- Búsqueda web ----
# Tavily: tier gratis ~1000 créditos/mes, sin tarjeta. https://app.tavily.com
TAVILY_API_KEY=tu_tavily_api_key_aqui

# ---- Google Maps Platform (Geocoding API v4 + Places API New) ----
# El código usa los endpoints NUEVOS: Geocoding v4 (geocode.googleapis.com/v4) y
# Places API (New). La "Demo Key" de Google los soporta SIN billing (ideal para el POC).
# Obtén una demo key en: https://developers.google.com/maps/documentation/
# Para producción/alto volumen: key normal con billing y restricciones.
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# ---- Censo INE a nivel manzana (opcional) ----
# URL de la capa "Manzana Entidad Censo 2024" en el FeatureServer ArcGIS del INE.
# Confirmar en geoine-ine-chile.opendata.arcgis.com y pegar aquí (termina en /FeatureServer/0).
# Si se deja vacío, el contexto de manzana queda "no disponible" sin romper el flujo.
INE_ARCGIS_LAYER_URL=

# ---- Parámetros opcionales ----
# Radio de búsqueda de POIs en metros
POI_RADIUS_M=1000
# Activar/desactivar el componente de delincuencia (true/false)
ENABLE_CRIME=true
